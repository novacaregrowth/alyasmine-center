# ─── Al Yasmine Center — Environment Variables ────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Calendly ──────────────────────────────────────────────────────────────────
# Your Calendly account's personal access token
# Get it from: https://calendly.com/integrations/api_webhooks
CALENDLY_API_TOKEN=

# Calendly webhook signing key (for verifying incoming webhook requests)
CALENDLY_WEBHOOK_SIGNING_KEY=

# Your public Calendly scheduling URL (used in the booking embed)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up at https://resend.com
RESEND_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://alyasminecenter.com

# ── Auth (add when ready — Clerk or NextAuth recommended) ─────────────────────
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

# ── Database (optional — add if you extend beyond Calendly) ───────────────────
# DATABASE_URL=

# Admin password — server-side only, never use NEXT_PUBLIC_ prefix
# Change this before deploying to production
ADMIN_PASSWORD=change-this-before-launch
